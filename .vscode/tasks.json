// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
  "version": "2.0.0",
  "tasks": [
    {
      // A shell task, not `"type": "npm"`: VS Code picks yarn for npm tasks
      // in some workspaces, and the extension is installed with npm.
      "label": "npm: watch",
      "type": "shell",
      "command": "npm run watch",
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^([^\\s].*?)\\((\\d+,\\d+)\\):\\s+(error|warning)\\s+TS(\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          // webpack-cli's own lines: the host needs the extension's compiler
          // only; the webviews' compilers finish soon after (reload to see them).
          "beginsPattern": "Compiler\\s*'extension' starting",
          "endsPattern": "Compiler\\s*'extension' finished"
        }
      },
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: watch-tests",
      "type": "shell",
      "command": "npm run watch-tests",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never",
        "group": "watchers"
      },
      "group": "build"
    },
    {
      "label": "tasks: watch-tests",
      "dependsOn": ["npm: watch", "npm: watch-tests"],
      "problemMatcher": []
    }
  ]
}
